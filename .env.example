# ---------------------------------------------------------------------------
# Optional environment overrides. NONE are required to run — the defaults in
# app/lib/config.ts already point at the right spreadsheet and tab gids.
# Set these in Vercel → Project → Settings → Environment Variables if you ever
# move to a different spreadsheet or re-publish tabs under new gids.
# ---------------------------------------------------------------------------

# Base of the "Publish to web -> CSV" URL, WITHOUT the trailing &gid=...
# (everything up to and including `/pub?output=csv`).
# NEXT_PUBLIC_SHEET_PUB_BASE=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv

# Published-to-web gid for each tab.
# NEXT_PUBLIC_SHEET_DAILY_GID=0
# NEXT_PUBLIC_SHEET_TARGET_GID=1170729989
# NEXT_PUBLIC_SHEET_NU_GID=1699661674
# NEXT_PUBLIC_SHEET_TRAINING_GID=1990560513

# Client auto-refresh cadence in milliseconds (floored at 60000 = 60s).
# NEXT_PUBLIC_REFRESH_MS=60000
